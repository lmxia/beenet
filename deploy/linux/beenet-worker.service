[Unit]
Description=Beenet worker
Documentation=https://github.com/lmxia/beenet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# systemd starts the daemon (like dockerd.service). Do not set CPUQuota /
# MemoryMax / TasksMax here — bworker applies [worker.quota] via cgroup v2.
Delegate=yes
# First boot: put the one-time join token at join_token (see LoadCredential below)
# or pass --join-token-file. Later boots skip enroll.
# LoadCredential=join_token
ExecStart=/usr/local/bin/beenet-worker --foreground
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
