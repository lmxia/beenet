# Build context: beenet/ workspace root.
#   docker build -f docker/Dockerfile.dashboard -t beenet/dashboard:dev .

FROM node:18-alpine AS builder

WORKDIR /build

COPY dashboard/package.json dashboard/package-lock.json ./

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=$HTTP_PROXY \
    HTTPS_PROXY=$HTTPS_PROXY \
    NO_PROXY=$NO_PROXY \
    http_proxy=$HTTP_PROXY \
    https_proxy=$HTTPS_PROXY \
    no_proxy=$NO_PROXY

RUN npm ci

COPY dashboard/ ./
RUN npm run build

FROM nginx:alpine AS runtime

COPY dashboard/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

COPY --from=builder /build/dist /usr/share/nginx/html

ENV REGISTRY_UPSTREAM=http://beenet-registry:3030
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
